{
  "name": "@natesclaw/lobster",
  "version": "2026.8.1",
  "description": "Lobster workflow tool plugin for typed pipelines and resumable approvals.",
  "repository": {
    "type": "git",
    "url": "https://github.com/natesclaw/natesclaw"
  },
  "type": "module",
  "dependencies": {
    "@clawdbot/lobster": "2026.6.11",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@natesclaw/plugin-sdk": "workspace:*"
  },
  "natesclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@natesclaw/lobster",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.25"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "natesclawVersion": "2026.8.1"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
