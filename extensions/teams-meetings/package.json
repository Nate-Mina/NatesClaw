{
  "name": "@natesclaw/teams-meetings",
  "version": "2026.8.1",
  "description": "Natesclaw Microsoft Teams browser meeting participant plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/natesclaw/natesclaw"
  },
  "type": "module",
  "dependencies": {
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@natesclaw/plugin-sdk": "workspace:*",
    "natesclaw": "workspace:*"
  },
  "peerDependencies": {
    "natesclaw": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "natesclaw": {
      "optional": true
    }
  },
  "natesclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@natesclaw/teams-meetings",
      "npmSpec": "@natesclaw/teams-meetings",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.2"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "natesclawVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
