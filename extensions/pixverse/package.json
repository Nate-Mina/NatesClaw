{
  "name": "@openclaw/pixverse-provider",
  "version": "2026.8.1",
  "description": "Natesclaw PixVerse video generation provider plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/natesclaw"
  },
  "type": "module",
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "natesclaw": "workspace:*"
  },
  "peerDependencies": {
    "natesclaw": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "natesclaw": {
      "optional": true
    }
  },
  "natesclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@openclaw/pixverse-provider",
      "npmSpec": "@openclaw/pixverse-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.26"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "natesclawVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
