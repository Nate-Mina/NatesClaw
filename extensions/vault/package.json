{
  "name": "@natesclaw/vault",
  "version": "2026.8.1",
  "private": true,
  "description": "HashiCorp Vault SecretRef provider integration for Natesclaw",
  "type": "module",
  "devDependencies": {
    "@natesclaw/plugin-sdk": "workspace:*"
  },
  "natesclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "staticAssets": [
        {
          "source": "./vault-secret-ref-resolver.js",
          "output": "vault-secret-ref-resolver.js"
        },
        {
          "source": "./vault-secret-id.js",
          "output": "vault-secret-id.js"
        }
      ]
    }
  }
}
