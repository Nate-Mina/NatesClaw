// Default signing values for shared/repo builds.
// Auto-selected local team overrides live in .local-signing.xcconfig (git-ignored).
// Manual local overrides can go in LocalSigning.xcconfig (git-ignored).

#include "build/Version.xcconfig"

NATESCLAW_CODE_SIGN_STYLE = Manual
NATESCLAW_CODE_SIGN_IDENTITY = Apple Development
NATESCLAW_CODE_SIGN_ENTITLEMENTS = Sources/Natesclaw.entitlements
NATESCLAW_DEVELOPMENT_TEAM = FWJYW4S8P8

NATESCLAW_APP_BUNDLE_ID = ai.natesclawfoundation.app
NATESCLAW_SHARE_BUNDLE_ID = ai.natesclawfoundation.app.share
NATESCLAW_APP_GROUP_ID = group.ai.natesclawfoundation.app.shared
NATESCLAW_WATCH_APP_BUNDLE_ID = ai.natesclawfoundation.app.watchkitapp
NATESCLAW_ACTIVITY_WIDGET_BUNDLE_ID = ai.natesclawfoundation.app.activitywidget
NATESCLAW_APNS_ENTITLEMENT_ENVIRONMENT = development

NATESCLAW_APP_PROFILE = ai.natesclawfoundation.app Development
NATESCLAW_SHARE_PROFILE = ai.natesclawfoundation.app.share Development
NATESCLAW_ACTIVITY_WIDGET_PROFILE =
NATESCLAW_WATCH_APP_PROFILE =

// Keep local includes after defaults: xcconfig is evaluated top-to-bottom,
// so later assignments in local files override the defaults above.
#include? ".local-signing.xcconfig"
#include? "LocalSigning.xcconfig"

// Debug products install alongside release products and keep their app-group data separate.
NATESCLAW_DEBUG_APP_BUNDLE_ID = $(NATESCLAW_APP_BUNDLE_ID).debug
NATESCLAW_DEBUG_SHARE_BUNDLE_ID = $(NATESCLAW_DEBUG_APP_BUNDLE_ID).share
NATESCLAW_DEBUG_ACTIVITY_WIDGET_BUNDLE_ID = $(NATESCLAW_DEBUG_APP_BUNDLE_ID).activitywidget
NATESCLAW_DEBUG_WATCH_APP_BUNDLE_ID = $(NATESCLAW_DEBUG_APP_BUNDLE_ID).watchkitapp
NATESCLAW_DEBUG_APP_GROUP_ID = $(NATESCLAW_APP_GROUP_ID).debug
