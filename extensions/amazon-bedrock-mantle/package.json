{
  "name": "@natesclaw/amazon-bedrock-mantle-provider",
  "version": "2026.8.1",
  "description": "Natesclaw Amazon Bedrock Mantle provider plugin for OpenAI-compatible model routing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/natesclaw/natesclaw"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@aws/bedrock-token-generator": "1.1.0"
  },
  "devDependencies": {
    "@natesclaw/plugin-sdk": "workspace:*"
  },
  "natesclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@natesclaw/amazon-bedrock-mantle-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "natesclawVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
