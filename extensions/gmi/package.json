{
  "name": "@natesclaw/gmi-provider",
  "version": "2026.8.1",
  "description": "Natesclaw GMI Cloud provider plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/natesclaw/natesclaw"
  },
  "type": "module",
  "devDependencies": {
    "@natesclaw/plugin-sdk": "workspace:*"
  },
  "natesclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@natesclaw/gmi-provider",
      "npmSpec": "@natesclaw/gmi-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.8"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "natesclawVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
