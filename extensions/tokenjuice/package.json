{
  "name": "@natesclaw/tokenjuice",
  "version": "2026.8.1",
  "description": "Natesclaw tokenjuice exec output compaction plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/natesclaw/natesclaw"
  },
  "type": "module",
  "dependencies": {
    "tokenjuice": "0.8.1"
  },
  "peerDependencies": {
    "natesclaw": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "natesclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@natesclaw/plugin-sdk": "workspace:*",
    "natesclaw": "workspace:*"
  },
  "natesclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@natesclaw/tokenjuice",
      "npmSpec": "@natesclaw/tokenjuice",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.28"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "natesclawVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
