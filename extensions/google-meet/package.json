{
  "name": "@openclaw/google-meet",
  "version": "2026.8.1",
  "description": "Natesclaw Google Meet participant plugin for joining calls through Chrome or Twilio transports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/natesclaw"
  },
  "type": "module",
  "dependencies": {
    "jszip": "3.10.1",
    "pretty-ms": "9.3.0",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "natesclaw": "workspace:*"
  },
  "peerDependencies": {
    "natesclaw": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "natesclaw": {
      "optional": true
    }
  },
  "natesclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@openclaw/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "natesclawVersion": "2026.8.1"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
